{
  "compilerOptions": {
    "target": "ES2022",
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src"]
}
