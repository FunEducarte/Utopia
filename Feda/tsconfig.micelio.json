{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",

    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/utopy/micelio/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
